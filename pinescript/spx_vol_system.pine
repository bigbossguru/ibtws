// SPX Volatility Analysis System for Options Premium Selling
// Overlay indicator with Expected Move bands, strike levels, and on-chart dashboard
//@version=5
indicator("SPX Vol Analysis System", overlay=true, max_lines_count=500, max_labels_count=50)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
grp_data = "Data Sources"
vix_sym      = input.symbol("CBOE:VIX",   "VIX",        group=grp_data)
vix1d_sym    = input.symbol("CBOE:VIX1D", "VIX1D",      group=grp_data)
vix9d_sym    = input.symbol("CBOE:VIX9D", "VIX9D",      group=grp_data)
vix3m_sym    = input.symbol("CBOE:VIX3M", "VIX3M",      group=grp_data)
vvix_sym     = input.symbol("CBOE:VVIX",  "VVIX",       group=grp_data)

grp_params = "Parameters"
zscore_len   = input.int(20, "Z-Score Lookback", minval=5, group=grp_params)
rv_len       = input.int(20, "Realized Vol Lookback", minval=5, group=grp_params)
dte_weekly   = input.int(7,  "Weekly DTE", minval=1, group=grp_params)
dte_monthly  = input.int(30, "Monthly DTE", minval=14, group=grp_params)

grp_display = "Display"
show_em_bands  = input.bool(true, "Expected Move Bands", group=grp_display)
show_strikes   = input.bool(true, "Recommended Strikes", group=grp_display)
show_dashboard = input.bool(true, "Dashboard Panel", group=grp_display)
dash_pos       = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_display)

// ─── DATA ────────────────────────────────────────────────────────────────────
vix   = request.security(vix_sym,   timeframe.period, close)
vix1d = request.security(vix1d_sym, timeframe.period, close)
vix9d = request.security(vix9d_sym, timeframe.period, close)
vix3m = request.security(vix3m_sym, timeframe.period, close)
vvix  = request.security(vvix_sym,  timeframe.period, close)

spx = close

// ─── METRIC 1: VIX Z-SCORE ──────────────────────────────────────────────────
vix_sma   = ta.sma(vix, zscore_len)
vix_stdev = ta.stdev(vix, zscore_len)
vix_zscore = vix_stdev != 0 ? (vix - vix_sma) / vix_stdev : 0.0

// ─── METRIC 2: EXPECTED MOVE (anchored to session open) ──────────────────────
em_1d      = spx * (vix / 100.0) / math.sqrt(252)
em_weekly  = spx * (vix / 100.0) / math.sqrt(252) * math.sqrt(dte_weekly)
em_monthly = spx * (vix / 100.0) / math.sqrt(252) * math.sqrt(dte_monthly)

// Capture open price and VIX at session open (9:30) — EM levels stay fixed for the day
var float open_price = na
var float open_vix   = na
is_new_session = ta.change(time("D")) != 0
if is_new_session
    open_price := open
    open_vix   := vix

em_open_1d  = open_price * (open_vix / 100.0) / math.sqrt(252)
em_open_w   = open_price * (open_vix / 100.0) / math.sqrt(252) * math.sqrt(dte_weekly)
em_open_m   = open_price * (open_vix / 100.0) / math.sqrt(252) * math.sqrt(dte_monthly)

// ─── METRIC 3: TERM STRUCTURE ────────────────────────────────────────────────
ratio_macro    = vix3m != 0 ? vix / vix3m : 1.0
ratio_weekly   = vix9d != 0 ? vix / vix9d : 1.0
ratio_intraday = vix   != 0 ? vix1d / vix : 1.0

// ─── METRIC 4: VRP ──────────────────────────────────────────────────────────
log_ret = math.log(close / close[1])
rv_20   = ta.stdev(log_ret, rv_len) * math.sqrt(252) * 100
vrp     = vix - rv_20

// ─── METRIC 5: VVIX ─────────────────────────────────────────────────────────
vvix_declining = vvix < vvix[1]

// ─── CIRCUIT BREAKER ─────────────────────────────────────────────────────────
circuit_breaker = ratio_macro > 1.15 or vix_zscore < -2.0

// ─── STRATEGY SIGNALS ────────────────────────────────────────────────────────
// 0DTE
sig_0dte_green = ratio_intraday > 1.25 and ratio_intraday < ratio_intraday[1] and vvix_declining
// Weekly
sig_weekly_green = vix_zscore > 1.5 and ratio_weekly < 0.90 and vrp > 0
// Monthly
sig_monthly_green = vix_zscore > 1.0 and ratio_macro < 1.0 and vrp > 2.0

signal_0dte   = circuit_breaker ? 2 : sig_0dte_green ? 0 : 1
signal_weekly  = circuit_breaker ? 2 : sig_weekly_green ? 0 : 1
signal_monthly = circuit_breaker ? 2 : sig_monthly_green ? 0 : 1

// ─── SESSION OPEN VERTICAL LINE ──────────────────────────────────────────────
if is_new_session
    line.new(bar_index, low - ta.atr(14), bar_index, high + ta.atr(14), color=color.new(color.white, 60), style=line.style_dashed, width=1)

// ─── EXPECTED MOVE BANDS (filled zones, anchored to session open) ────────────
em_up_0 = open_price + em_open_1d
em_dn_0 = open_price - em_open_1d
em_up_w = open_price + em_open_w
em_dn_w = open_price - em_open_w
em_up_m = open_price + em_open_m
em_dn_m = open_price - em_open_m

p_eu_m = plot(show_em_bands ? em_up_m : na, "EM+ Monthly", color=color.new(color.purple, 80), linewidth=1)
p_ed_m = plot(show_em_bands ? em_dn_m : na, "EM- Monthly", color=color.new(color.purple, 80), linewidth=1)
p_eu_w = plot(show_em_bands ? em_up_w : na, "EM+ Weekly",  color=color.new(color.blue, 60), linewidth=2)
p_ed_w = plot(show_em_bands ? em_dn_w : na, "EM- Weekly",  color=color.new(color.blue, 60), linewidth=2)
p_eu_0 = plot(show_em_bands ? em_up_0 : na, "EM+ 0DTE",   color=color.new(color.orange, 50), linewidth=2, style=plot.style_stepline)
p_ed_0 = plot(show_em_bands ? em_dn_0 : na, "EM- 0DTE",   color=color.new(color.orange, 50), linewidth=2, style=plot.style_stepline)
p_mid  = plot(show_em_bands ? spx : na, "SPX Mid", color=color.new(color.gray, 100), display=display.none)

fill(p_eu_0, p_mid, color=color.new(color.orange, 94), title="EM 0DTE Upper Fill")
fill(p_ed_0, p_mid, color=color.new(color.orange, 94), title="EM 0DTE Lower Fill")
fill(p_eu_w, p_eu_0, color=color.new(color.blue, 95), title="EM Weekly Upper Fill")
fill(p_ed_w, p_ed_0, color=color.new(color.blue, 95), title="EM Weekly Lower Fill")
fill(p_eu_m, p_eu_w, color=color.new(color.purple, 95), title="EM Monthly Upper Fill")
fill(p_ed_m, p_ed_w, color=color.new(color.purple, 95), title="EM Monthly Lower Fill")

// ─── STRIKE LEVELS ───────────────────────────────────────────────────────────
strike_0dte   = open_price - 1.5 * em_open_1d
strike_weekly = open_price - 2.0 * em_open_w
strike_monthly = open_price - 2.5 * em_open_m

// Plot strikes only when signal is GREEN
plot(show_strikes and signal_0dte == 0 ? strike_0dte : na, "Strike 0DTE", color=color.lime, style=plot.style_linebr, linewidth=2)
plot(show_strikes and signal_weekly == 0 ? strike_weekly : na, "Strike Weekly", color=color.green, style=plot.style_linebr, linewidth=2)
plot(show_strikes and signal_monthly == 0 ? strike_monthly : na, "Strike Monthly", color=color.teal, style=plot.style_linebr, linewidth=1)

// ─── ON-CHART SIGNAL MARKERS ─────────────────────────────────────────────────
// Entry arrows when signal flips to GREEN
plotshape(signal_0dte == 0 and signal_0dte[1] != 0, "0DTE Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="0DTE")
plotshape(signal_weekly == 0 and signal_weekly[1] != 0, "Weekly Entry", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="WK")
plotshape(signal_monthly == 0 and signal_monthly[1] != 0, "Monthly Entry", style=shape.diamond, location=location.belowbar, color=color.teal, size=size.tiny, text="MO")

// Circuit breaker activation
plotshape(circuit_breaker and not circuit_breaker[1], "CB ON", style=shape.xcross, location=location.abovebar, color=color.red, size=size.normal, text="HALT")

// ─── BACKGROUND ──────────────────────────────────────────────────────────────
bgcolor(circuit_breaker ? color.new(color.red, 93) : na, title="Circuit Breaker BG")
bgcolor(vix_zscore > 2.0 and not circuit_breaker ? color.new(color.orange, 94) : na, title="Panic BG")

// ─── BAR COLORING (subtle regime hint) ───────────────────────────────────────
barcolor(circuit_breaker ? color.new(color.red, 40) : vix_zscore > 2.0 ? color.new(color.orange, 40) : na, title="Regime Bar Color")

// ─── DASHBOARD TABLE ─────────────────────────────────────────────────────────
if show_dashboard and barstate.islast
    tbl_pos = switch dash_pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

    var tbl = table.new(tbl_pos, 3, 14, border_width=1, border_color=color.new(color.gray, 70), bgcolor=color.new(#1a1a2e, 0))

    // ── Header
    table.cell(tbl, 0, 0, "SPX VOL SYSTEM", text_color=color.white, bgcolor=color.new(#16213e, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 0, "", bgcolor=color.new(#16213e, 0))
    table.cell(tbl, 2, 0, "", bgcolor=color.new(#16213e, 0))
    table.merge_cells(tbl, 0, 0, 2, 0)

    // ── Market Context
    table.cell(tbl, 0, 1, "SPX",  text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 1, str.tostring(spx, "#.0"), text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 1, "", text_size=size.tiny)

    z_col = vix_zscore > 2 ? color.red : vix_zscore > 1 ? color.orange : vix_zscore < -2 ? color.yellow : color.white
    table.cell(tbl, 0, 2, "VIX",  text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(vix, "#.##"), text_color=z_col, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 2, "Z:" + str.tostring(vix_zscore, "+#.##"), text_color=z_col, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 3, "VVIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 3, str.tostring(vvix, "#.#"), text_color=vvix > 120 ? color.orange : color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 3, vvix_declining ? "↓ Decl" : "↑ Rise", text_color=vvix_declining ? color.green : color.orange, text_size=size.tiny, text_halign=text.align_right)

    // ── Term Structure
    table.cell(tbl, 0, 4, "TERM STRUCT", text_color=color.new(color.aqua, 30), text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(#0f3460, 0))
    table.cell(tbl, 1, 4, "", bgcolor=color.new(#0f3460, 0), text_size=size.tiny)
    table.cell(tbl, 2, 4, "", bgcolor=color.new(#0f3460, 0), text_size=size.tiny)

    table.cell(tbl, 0, 5, "VIX/3M", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 5, str.tostring(ratio_macro, "#.##"), text_color=ratio_macro > 1.0 ? color.red : color.green, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 5, ratio_macro > 1.0 ? "BW" : "CT", text_color=ratio_macro > 1.0 ? color.red : color.green, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 6, "VIX/9D", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(ratio_weekly, "#.##"), text_color=ratio_weekly < 1.0 ? color.orange : color.green, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 6, ratio_weekly < 1.0 ? "LBW" : "CT", text_color=ratio_weekly < 1.0 ? color.orange : color.green, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 7, "1D/VIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 7, str.tostring(ratio_intraday, "#.##"), text_color=ratio_intraday > 1.0 ? color.red : color.green, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 7, ratio_intraday > 1.25 ? "🔥" : ratio_intraday > 1.0 ? "HOT" : "OK", text_color=ratio_intraday > 1.0 ? color.red : color.green, text_size=size.tiny, text_halign=text.align_right)

    // ── Risk
    table.cell(tbl, 0, 8, "RISK", text_color=color.new(color.aqua, 30), text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(#0f3460, 0))
    table.cell(tbl, 1, 8, "", bgcolor=color.new(#0f3460, 0), text_size=size.tiny)
    table.cell(tbl, 2, 8, "", bgcolor=color.new(#0f3460, 0), text_size=size.tiny)

    table.cell(tbl, 0, 9, "VRP", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 9, str.tostring(vrp, "+#.#"), text_color=vrp > 0 ? color.green : color.red, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 9, vrp > 0 ? "EDGE" : "NONE", text_color=vrp > 0 ? color.green : color.red, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 10, "EM±", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 10, str.tostring(em_open_w, "#") + "w", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 10, str.tostring(em_open_1d, "#") + "d", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    // ── Signals
    table.cell(tbl, 0, 11, "SIGNALS", text_color=color.new(color.aqua, 30), text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(#0f3460, 0))
    table.cell(tbl, 1, 11, "", bgcolor=color.new(#0f3460, 0), text_size=size.tiny)
    table.cell(tbl, 2, 11, "", bgcolor=color.new(#0f3460, 0), text_size=size.tiny)

    _sc = signal_0dte == 0 ? color.lime : signal_0dte == 1 ? color.yellow : color.red
    _sw = signal_weekly == 0 ? color.lime : signal_weekly == 1 ? color.yellow : color.red
    _sm = signal_monthly == 0 ? color.lime : signal_monthly == 1 ? color.yellow : color.red
    _st0 = signal_0dte == 0 ? "● GREEN" : signal_0dte == 1 ? "● YELLOW" : "● RED"
    _stw = signal_weekly == 0 ? "● GREEN" : signal_weekly == 1 ? "● YELLOW" : "● RED"
    _stm = signal_monthly == 0 ? "● GREEN" : signal_monthly == 1 ? "● YELLOW" : "● RED"

    table.cell(tbl, 0, 12, "0DTE", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 12, _st0, text_color=_sc, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 12, signal_0dte == 0 ? "<" + str.tostring(strike_0dte, "#") : "", text_color=color.lime, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 13, "WK / MO", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 13, _stw, text_color=_sw, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 13, _stm, text_color=_sm, text_size=size.tiny, text_halign=text.align_right)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(circuit_breaker and not circuit_breaker[1], "Circuit Breaker ON", "⚠️ SPX Vol: CIRCUIT BREAKER — halt put selling")
alertcondition(sig_0dte_green and not sig_0dte_green[1], "0DTE GREEN", "🟢 0DTE Entry — VIX1D reversal + VVIX declining")
alertcondition(sig_weekly_green and not sig_weekly_green[1], "Weekly GREEN", "🟢 Weekly Entry — Z>1.5, fear spike, VRP+")
alertcondition(sig_monthly_green and not sig_monthly_green[1], "Monthly GREEN", "🟢 Monthly Entry — elevated vol, contango, VRP>2")
