// SPX Volatility Traffic Light System + Markov Regime
// Full 9-metric rule engine with Put Credit Spread / BWB strategy signals
// Markov regime (Bull/Bear/Sideways) integrated as market context filter
//@version=5
indicator("SPX Vol Traffic Light + Markov", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
grp_data = "Data Sources"
vix_sym      = input.symbol("CBOE:VIX",   "VIX",        group=grp_data)
vix1d_sym    = input.symbol("CBOE:VIX1D", "VIX1D",      group=grp_data)
vix9d_sym    = input.symbol("CBOE:VIX9D", "VIX9D",      group=grp_data)
vix3m_sym    = input.symbol("CBOE:VIX3M", "VIX3M",      group=grp_data)
vvix_sym     = input.symbol("CBOE:VVIX",  "VVIX",       group=grp_data)
cor1m_sym    = input.symbol("CBOE:COR1M", "COR1M (Implied Correlation)", group=grp_data)
skew_sym     = input.symbol("CBOE:SKEW",  "SKEW Index",  group=grp_data)

grp_params = "Parameters"
zscore_len   = input.int(20,  "Z-Score Lookback",       minval=5,  group=grp_params)
rv_len       = input.int(20,  "Realized Vol Lookback",  minval=5,  group=grp_params)
bbw_len      = input.int(20,  "BBW Length",             minval=10, group=grp_params)
bbw_mult     = input.float(2.0, "BBW StdDev Mult",     minval=1.0, group=grp_params)
dte_weekly   = input.int(7,   "Weekly DTE",             minval=1,  group=grp_params)
dte_monthly  = input.int(30,  "Monthly DTE",            minval=14, group=grp_params)

grp_markov = "Markov Regime"
mkv_lookback       = input.int(20,   "Lookback (bars)",       minval=5, maxval=250, group=grp_markov)
mkv_bull_thresh    = input.float(5.0, "Bull threshold (%)",   minval=0.1, step=0.1, group=grp_markov)
mkv_bear_thresh    = input.float(5.0, "Bear threshold (%)",   minval=0.1, step=0.1, group=grp_markov)
mkv_stationary_pow = input.int(50,   "Stationary iterations", minval=10, maxval=200, group=grp_markov)
mkv_min_hold       = input.int(4,    "Min bars for label",    minval=1,  maxval=50, group=grp_markov)

grp_display = "Display"
show_em_bands      = input.bool(true,  "Expected Move Bands",    group=grp_display)
show_strikes       = input.bool(true,  "Recommended Strikes",    group=grp_display)
show_dashboard     = input.bool(true,  "Dashboard Panel",        group=grp_display)
show_regime_ribbon = input.bool(true,  "Markov Regime Ribbon",   group=grp_display)
show_regime_labels = input.bool(true,  "Regime Transition Labels", group=grp_display)
show_matrix_table  = input.bool(false, "Transition Matrix Table", group=grp_display)
dash_pos           = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_display)
matrix_pos_input   = input.string("Top Right", "Matrix Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_display)

// ─── DATA ────────────────────────────────────────────────────────────────────
vix    = request.security(vix_sym,   timeframe.period, close)
vix1d  = request.security(vix1d_sym, timeframe.period, close)
vix9d  = request.security(vix9d_sym, timeframe.period, close)
vix3m  = request.security(vix3m_sym, timeframe.period, close)
vvix   = request.security(vvix_sym,  timeframe.period, close)
cor1m  = request.security(cor1m_sym, timeframe.period, close)
skew   = request.security(skew_sym,  timeframe.period, close)

spx = close

// ─── MARKOV REGIME ───────────────────────────────────────────────────────────
// regime: 0 = Sideways, 1 = Bull, 2 = Bear
mkv_log_ret = math.log(close / close[mkv_lookback])
regime = na(mkv_log_ret) ? int(na) : mkv_log_ret > mkv_bull_thresh / 100.0 ? 1 : mkv_log_ret < -mkv_bear_thresh / 100.0 ? 2 : 0

// Transition counting
var mkv_counts = array.new_int(9, 0)
mkv_prev = regime[1]
if barstate.isconfirmed and not na(mkv_prev) and not na(regime)
    mkv_idx = mkv_prev * 3 + regime
    array.set(mkv_counts, mkv_idx, array.get(mkv_counts, mkv_idx) + 1)

// Regime persistence (for labels)
var int mkv_last_lbl_regime = na
mkv_held = not na(regime)
for k = 0 to mkv_min_hold - 1
    mkv_held := mkv_held and not na(regime[k]) and regime[k] == regime

if barstate.isconfirmed and not na(regime) and mkv_held and regime != mkv_last_lbl_regime
    if show_regime_labels and not na(mkv_last_lbl_regime)
        flip_off = mkv_min_hold - 1
        lbl_name = (mkv_last_lbl_regime == 1 ? "BULL" : mkv_last_lbl_regime == 2 ? "BEAR" : "SIDE") + " → " + (regime == 1 ? "BULL" : regime == 2 ? "BEAR" : "SIDE")
        lbl_col = regime == 1 ? color.rgb(132, 187, 161, 30) : regime == 2 ? color.rgb(197, 127, 134, 30) : color.rgb(164, 171, 183, 30)
        label.new(bar_index - flip_off, high[flip_off], lbl_name, yloc=yloc.abovebar, style=label.style_label_down, color=lbl_col, textcolor=color.white, size=size.normal)
    mkv_last_lbl_regime := regime

// Regime ribbon
mkv_ribbon = regime == 1 ? color.rgb(132, 187, 161, 92) : regime == 2 ? color.rgb(197, 127, 134, 92) : color.rgb(164, 171, 183, 94)
bgcolor(show_regime_ribbon ? mkv_ribbon : na, title="Regime Ribbon")

// Regime as signal filter: Bear = headwind for put selling
regime_bear = regime == 2

// ─── METRIC 1: VIX Z-SCORE (20d) ────────────────────────────────────────────
vix_sma    = ta.sma(vix, zscore_len)
vix_stdev  = ta.stdev(vix, zscore_len)
vix_zscore = vix_stdev != 0 ? (vix - vix_sma) / vix_stdev : 0.0
vix_reversing_down = vix < vix[1] and vix[1] > vix[2]

zscore_green = vix_zscore > 1.5 and vix_reversing_down
zscore_red   = vix_zscore < -2.0

// ─── METRIC 2: VRP (VIX - RV20) ─────────────────────────────────────────────
log_ret = math.log(close / close[1])
rv_20   = ta.stdev(log_ret, rv_len) * math.sqrt(252) * 100
vrp     = vix - rv_20

vrp_green = vrp > 2.0
vrp_red   = vrp <= 0.0

// ─── METRIC 3: VIX1D/VIX (0DTE Ratio) ───────────────────────────────────────
ratio_0dte = vix != 0 ? vix1d / vix : 1.0
ratio_0dte_reversing = ratio_0dte < ratio_0dte[1] and ratio_0dte[1] > ratio_0dte[2]

r0dte_green = ratio_0dte > 1.25 and ratio_0dte_reversing
r0dte_red   = ratio_0dte > 1.0 and ratio_0dte > ratio_0dte[1]

// ─── METRIC 4: VIX9D/VIX (Weekly Ratio) ─────────────────────────────────────
ratio_weekly = vix != 0 ? vix9d / vix : 1.0
ratio_weekly_reversing = ratio_weekly < ratio_weekly[1] and ratio_weekly[1] > ratio_weekly[2]

rweekly_green = ratio_weekly > 1.15 and ratio_weekly_reversing
rweekly_red   = ratio_weekly > 1.10 and ratio_weekly > ratio_weekly[1]

// ─── METRIC 5: VIX/VIX3M (Macro Term Structure) ─────────────────────────────
ratio_macro = vix3m != 0 ? vix / vix3m : 1.0
macro_rising = ratio_macro > ratio_macro[1] and ratio_macro[1] > ratio_macro[2]

macro_green = ratio_macro < 1.0
macro_red   = ratio_macro > 1.15 and macro_rising

// ─── METRIC 6: VVIX ─────────────────────────────────────────────────────────
vvix_declining = vvix < vvix[1] and vvix[1] < vvix[2]
vix_elevated   = vix_zscore > 1.0

vvix_green = vvix_declining and vix_elevated
vvix_red   = vvix > 115 and vix_zscore < 0.5

// ─── METRIC 7: SKEW SLOPE RATIO ─────────────────────────────────────────────
skew_ratio = skew / 100.0
skew_sma   = ta.sma(skew_ratio, zscore_len)

skew_green = skew_ratio > 1.0
skew_red   = skew_ratio < skew_sma * 0.95

// ─── METRIC 8: COR1M (Implied Correlation) ──────────────────────────────────
cor1m_green = cor1m < 30
cor1m_red   = cor1m > 65

// ─── METRIC 9: BBW on SPX (Bollinger Band Width) ────────────────────────────
bb_basis = ta.sma(spx, bbw_len)
bb_upper = bb_basis + bbw_mult * ta.stdev(spx, bbw_len)
bb_lower = bb_basis - bbw_mult * ta.stdev(spx, bbw_len)
bbw      = bb_basis != 0 ? (bb_upper - bb_lower) / bb_basis * 100 : 0.0
bbw_min_60 = ta.lowest(bbw, 60)

bbw_green = bbw > bbw_min_60 * 1.1
bbw_red   = bbw <= bbw_min_60 * 1.02

// ─── COMPOSITE SCORING ───────────────────────────────────────────────────────
f_score(bool g, bool r) => g ? 1 : r ? -1 : 0

score_zscore  = f_score(zscore_green, zscore_red)
score_vrp     = f_score(vrp_green, vrp_red)
score_0dte    = f_score(r0dte_green, r0dte_red)
score_weekly  = f_score(rweekly_green, rweekly_red)
score_macro   = f_score(macro_green, macro_red)
score_vvix    = f_score(vvix_green, vvix_red)
score_skew    = f_score(skew_green, skew_red)
score_cor1m   = f_score(cor1m_green, cor1m_red)
score_bbw     = f_score(bbw_green, bbw_red)

// ─── CIRCUIT BREAKER (any critical RED = HALT) ───────────────────────────────
circuit_breaker = macro_red or zscore_red or cor1m_red

// ─── STRATEGY SIGNALS (regime-aware) ─────────────────────────────────────────
// Bear regime adds headwind: blocks GREEN, forces wider strikes

// 0DTE
green_0dte = r0dte_green and vrp_green and macro_green and not circuit_breaker and not regime_bear
yellow_0dte = not green_0dte and not circuit_breaker and not r0dte_red and vrp > 0
signal_0dte = circuit_breaker ? 2 : green_0dte ? 0 : yellow_0dte ? 1 : 2

// Weekly (7 DTE)
green_weekly = (rweekly_green or zscore_green) and vrp_green and macro_green and not bbw_red and not circuit_breaker and not regime_bear
yellow_weekly = not green_weekly and not circuit_breaker and vrp > 0 and ratio_macro < 1.05
signal_weekly = circuit_breaker ? 2 : green_weekly ? 0 : yellow_weekly ? 1 : 2

// Monthly (21-45 DTE)
total_pos = (score_zscore > 0 ? 1 : 0) + (score_vrp > 0 ? 1 : 0) + (score_macro > 0 ? 1 : 0) + (score_vvix > 0 ? 1 : 0) + (score_skew > 0 ? 1 : 0) + (score_cor1m > 0 ? 1 : 0) + (score_bbw > 0 ? 1 : 0)
total_neg = (score_zscore < 0 ? 1 : 0) + (score_vrp < 0 ? 1 : 0) + (score_macro < 0 ? 1 : 0) + (score_vvix < 0 ? 1 : 0) + (score_skew < 0 ? 1 : 0) + (score_cor1m < 0 ? 1 : 0) + (score_bbw < 0 ? 1 : 0)

green_monthly = total_pos >= 5 and total_neg == 0 and not circuit_breaker and not regime_bear
yellow_monthly = not green_monthly and not circuit_breaker and total_neg <= 1 and vrp > 0
signal_monthly = circuit_breaker ? 2 : green_monthly ? 0 : yellow_monthly ? 1 : 2

// ─── DELTA / DISTANCE RECOMMENDATION ────────────────────────────────────────
// Bear regime: widen strikes by 2 delta even on YELLOW
delta_adj = regime_bear ? -2 : 0
delta_0dte    = signal_0dte == 0 ? 12 + delta_adj : signal_0dte == 1 ? 8 + delta_adj : 0
delta_weekly  = signal_weekly == 0 ? 12 + delta_adj : signal_weekly == 1 ? 8 + delta_adj : 0
delta_monthly = signal_monthly == 0 ? 10 + delta_adj : signal_monthly == 1 ? 7 + delta_adj : 0

// ─── EXPECTED MOVE (tenor-matched, skew-adjusted) ────────────────────────────
var float open_price = na
is_new_session = session.isfirstbar
if is_new_session
    open_price := open

skew_down_mult = 1.0 + (skew - 100.0) / 300.0

em_1d = nz(open_price) * (vix1d / 100.0) * math.sqrt(1.0 / 252.0)
em_w  = nz(open_price) * (vix9d / 100.0) * math.sqrt(dte_weekly / 365.0)
em_m  = nz(open_price) * (vix   / 100.0) * math.sqrt(dte_monthly / 365.0)

// ─── STRIKE LEVELS (skew-adjusted, regime-aware) ─────────────────────────────
// Bear regime: widen multiplier by 0.5
regime_mult_adj = regime_bear ? 0.5 : 0.0
mult_0dte   = (signal_0dte == 0 ? 1.5 : 2.0) + regime_mult_adj
mult_weekly = (signal_weekly == 0 ? 1.5 : 2.0) + regime_mult_adj
mult_monthly = (signal_monthly == 0 ? 2.0 : 2.5) + regime_mult_adj

strike_0dte    = nz(open_price) - mult_0dte * em_1d * skew_down_mult
strike_weekly  = nz(open_price) - mult_weekly * em_w * skew_down_mult
strike_monthly = nz(open_price) - mult_monthly * em_m * skew_down_mult

// ─── EXPECTED MOVE BANDS (asymmetric) ────────────────────────────────────────
em_up_0 = nz(open_price) + em_1d
em_dn_0 = nz(open_price) - em_1d * skew_down_mult
em_up_w = nz(open_price) + em_w
em_dn_w = nz(open_price) - em_w * skew_down_mult
em_up_m = nz(open_price) + em_m
em_dn_m = nz(open_price) - em_m * skew_down_mult
em_mid  = nz(open_price)

p_eu_m = plot(show_em_bands ? em_up_m : na, "EM+ Monthly", color=color.new(color.purple, 80), linewidth=1)
p_ed_m = plot(show_em_bands ? em_dn_m : na, "EM- Monthly", color=color.new(color.purple, 80), linewidth=1)
p_eu_w = plot(show_em_bands ? em_up_w : na, "EM+ Weekly",  color=color.new(color.blue, 60), linewidth=2)
p_ed_w = plot(show_em_bands ? em_dn_w : na, "EM- Weekly",  color=color.new(color.blue, 60), linewidth=2)
p_eu_0 = plot(show_em_bands ? em_up_0 : na, "EM+ 0DTE",   color=color.new(color.orange, 50), linewidth=2, style=plot.style_stepline)
p_ed_0 = plot(show_em_bands ? em_dn_0 : na, "EM- 0DTE",   color=color.new(color.orange, 50), linewidth=2, style=plot.style_stepline)
p_mid  = plot(show_em_bands ? em_mid  : na, "Open Price",  color=color.new(color.white, 70), linewidth=1, style=plot.style_stepline)

fill(p_eu_0, p_mid, color=color.new(color.orange, 94))
fill(p_ed_0, p_mid, color=color.new(color.orange, 94))
fill(p_eu_w, p_eu_0, color=color.new(color.blue, 95))
fill(p_ed_w, p_ed_0, color=color.new(color.blue, 95))
fill(p_eu_m, p_eu_w, color=color.new(color.purple, 95))
fill(p_ed_m, p_ed_w, color=color.new(color.purple, 95))

// ─── STRIKE PLOTS ────────────────────────────────────────────────────────────
plot(show_strikes and signal_0dte != 2 ? strike_0dte : na, "Strike 0DTE", color=color.lime, style=plot.style_linebr, linewidth=2)
plot(show_strikes and signal_weekly != 2 ? strike_weekly : na, "Strike Weekly", color=color.green, style=plot.style_linebr, linewidth=2)
plot(show_strikes and signal_monthly != 2 ? strike_monthly : na, "Strike Monthly", color=color.teal, style=plot.style_linebr, linewidth=1)

// ─── ON-CHART MARKERS ────────────────────────────────────────────────────────
plotshape(signal_0dte == 0 and signal_0dte[1] != 0, "0DTE GO", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="0DTE")
plotshape(signal_weekly == 0 and signal_weekly[1] != 0, "Weekly GO", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="WK")
plotshape(signal_monthly == 0 and signal_monthly[1] != 0, "Monthly GO", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small, text="MO")
plotshape(circuit_breaker and not circuit_breaker[1], "CB ON", style=shape.xcross, location=location.abovebar, color=color.red, size=size.normal, text="HALT")

// ─── BACKGROUND (circuit breaker overrides regime ribbon) ────────────────────
bgcolor(circuit_breaker ? color.new(color.red, 93) : na, title="Circuit Breaker BG")
barcolor(circuit_breaker ? color.new(color.red, 40) : vix_zscore > 2.0 ? color.new(color.orange, 40) : na, title="Regime Bar Color")

// ─── HELPER FUNCTIONS ────────────────────────────────────────────────────────
f_light(int s) => s > 0 ? "🟢" : s < 0 ? "🔴" : "🟡"
f_sig(int sig) => sig == 0 ? "GO" : sig == 1 ? "WAIT" : "STOP"
f_sig_col(int sig) => sig == 0 ? color.lime : sig == 1 ? color.yellow : color.red
f_regime_name(int r) => r == 1 ? "BULL" : r == 2 ? "BEAR" : "SIDE"
f_regime_col(int r) => r == 1 ? color.rgb(132, 187, 161) : r == 2 ? color.rgb(197, 127, 134) : color.rgb(164, 171, 183)

// ─── MARKOV MATRIX MATH ─────────────────────────────────────────────────────
matmul_3x3(float[] A, float[] B) =>
    C = array.new_float(9, 0.0)
    for r = 0 to 2
        for c = 0 to 2
            array.set(C, r * 3 + c, array.get(A, r * 3 + 0) * array.get(B, 0 * 3 + c) + array.get(A, r * 3 + 1) * array.get(B, 1 * 3 + c) + array.get(A, r * 3 + 2) * array.get(B, 2 * 3 + c))
    C

fmt_pct(float p) => str.tostring(math.round(p * 100)) + "%"

// Display order: Bull(0) Bear(1) Side(2) → internal: 1, 2, 0
disp_to_internal(int d) => d == 0 ? 1 : d == 1 ? 2 : 0

// ─── DASHBOARD ───────────────────────────────────────────────────────────────
if show_dashboard and barstate.islast
    tbl_pos = switch dash_pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

    var tbl = table.new(tbl_pos, 3, 17, border_width=1, border_color=color.new(color.gray, 70), bgcolor=color.new(#1a1a2e, 0))

    // ── Header
    table.cell(tbl, 0, 0, "METRIC", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "VALUE", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 0, "", text_size=size.tiny)

    // ── Row 1: Markov Regime
    table.cell(tbl, 0, 1, "REGIME", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 1, f_regime_name(regime), text_color=f_regime_col(regime), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 1, regime == 1 ? "🟢" : regime == 2 ? "🔴" : "🟡", text_size=size.tiny)

    // ── Row 2: VIX Z-Score
    table.cell(tbl, 0, 2, "VIX Z", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(vix, "#.#") + " Z:" + str.tostring(vix_zscore, "+#.##"), text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 2, f_light(score_zscore), text_size=size.tiny)

    // ── Row 3: VRP
    table.cell(tbl, 0, 3, "VRP", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 3, str.tostring(vrp, "+#.#") + "%", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 3, f_light(score_vrp), text_size=size.tiny)

    // ── Row 4: VIX1D/VIX
    table.cell(tbl, 0, 4, "1D/VIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 4, str.tostring(ratio_0dte, "#.##"), text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 4, f_light(score_0dte), text_size=size.tiny)

    // ── Row 5: VIX9D/VIX
    table.cell(tbl, 0, 5, "9D/VIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 5, str.tostring(ratio_weekly, "#.##"), text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 5, f_light(score_weekly), text_size=size.tiny)

    // ── Row 6: VIX/VIX3M
    table.cell(tbl, 0, 6, "VIX/3M", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(ratio_macro, "#.##") + (ratio_macro < 1.0 ? " CT" : " BW"), text_color=ratio_macro < 1.0 ? color.green : color.red, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 6, f_light(score_macro), text_size=size.tiny)

    // ── Row 7: VVIX
    table.cell(tbl, 0, 7, "VVIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 7, str.tostring(vvix, "#.#") + (vvix_declining ? " ↓" : " ↑"), text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 7, f_light(score_vvix), text_size=size.tiny)

    // ── Row 8: Skew
    table.cell(tbl, 0, 8, "SKEW", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 8, str.tostring(skew, "#.#") + " (" + str.tostring(skew_ratio, "#.##") + ")", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 8, f_light(score_skew), text_size=size.tiny)

    // ── Row 9: COR1M
    table.cell(tbl, 0, 9, "COR1M", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 9, str.tostring(cor1m, "#.#"), text_color=cor1m < 30 ? color.green : cor1m > 65 ? color.red : color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 9, f_light(score_cor1m), text_size=size.tiny)

    // ── Row 10: BBW
    table.cell(tbl, 0, 10, "BBW", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 10, str.tostring(bbw, "#.##") + "%", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 10, f_light(score_bbw), text_size=size.tiny)

    // ── Row 11: EM
    table.cell(tbl, 0, 11, "EM↓", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 11, str.tostring(em_1d * skew_down_mult, "#") + "d " + str.tostring(em_w * skew_down_mult, "#") + "w " + str.tostring(em_m * skew_down_mult, "#") + "m", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 11, "×" + str.tostring(skew_down_mult, "#.##"), text_color=color.gray, text_size=size.tiny)

    // ── Separator
    table.cell(tbl, 0, 12, "─────", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 12, "SIGNAL", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 12, "Δ", text_color=color.gray, text_size=size.tiny)

    // ── Strategy signals
    table.cell(tbl, 0, 13, "0DTE", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 13, f_sig(signal_0dte) + (signal_0dte != 2 ? " <" + str.tostring(strike_0dte, "#") : ""), text_color=f_sig_col(signal_0dte), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 13, signal_0dte != 2 ? str.tostring(delta_0dte) + "Δ" : "—", text_color=f_sig_col(signal_0dte), text_size=size.tiny)

    table.cell(tbl, 0, 14, "WEEKLY", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 14, f_sig(signal_weekly) + (signal_weekly != 2 ? " <" + str.tostring(strike_weekly, "#") : ""), text_color=f_sig_col(signal_weekly), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 14, signal_weekly != 2 ? str.tostring(delta_weekly) + "Δ" : "—", text_color=f_sig_col(signal_weekly), text_size=size.tiny)

    table.cell(tbl, 0, 15, "MONTHLY", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 15, f_sig(signal_monthly) + (signal_monthly != 2 ? " <" + str.tostring(strike_monthly, "#") : ""), text_color=f_sig_col(signal_monthly), text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 2, 15, signal_monthly != 2 ? str.tostring(delta_monthly) + "Δ" : "—", text_color=f_sig_col(signal_monthly), text_size=size.tiny)

    // ── Row 16: Regime note when Bear
    regime_note = regime_bear ? "⚠ BEAR: strikes widened" : ""
    table.cell(tbl, 0, 16, regime_note, text_color=color.rgb(197, 127, 134), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 16, "", text_size=size.tiny)
    table.cell(tbl, 2, 16, "", text_size=size.tiny)

// ─── TRANSITION MATRIX TABLE ─────────────────────────────────────────────────
if show_matrix_table and barstate.islast
    mat_pos = switch matrix_pos_input
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

    var tbl_m = table.new(mat_pos, 4, 6, border_width=1, border_color=color.new(#3FDE7E, 78), bgcolor=color.new(#0B0F0D, 8))

    // Build P: row-normalise counts
    P = array.new_float(9, 0.0)
    for r = 0 to 2
        row_sum = array.get(mkv_counts, r * 3) + array.get(mkv_counts, r * 3 + 1) + array.get(mkv_counts, r * 3 + 2)
        for c = 0 to 2
            cell = row_sum > 0 ? array.get(mkv_counts, r * 3 + c) / row_sum : 1.0 / 3.0
            array.set(P, r * 3 + c, cell)

    // Stationary distribution via matrix power
    M = array.copy(P)
    for _i = 1 to mkv_stationary_pow - 1
        M := matmul_3x3(M, P)

    // Header
    table.cell(tbl_m, 0, 0, "MARKOV", text_color=#3FDE7E, bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl_m, 1, 0, "", bgcolor=color.new(#0B0F0D, 8))
    table.cell(tbl_m, 2, 0, "", bgcolor=color.new(#0B0F0D, 8))
    table.cell(tbl_m, 3, 0, "3×3", text_color=color.new(color.white, 60), bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_right)

    // Column headers
    table.cell(tbl_m, 0, 1, "", bgcolor=color.new(#0B0F0D, 8))
    table.cell(tbl_m, 1, 1, "BULL", text_color=color.new(color.white, 35), bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl_m, 2, 1, "BEAR", text_color=color.new(color.white, 35), bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl_m, 3, 1, "SIDE", text_color=color.new(color.white, 35), bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_center)

    // Matrix rows
    for r = 0 to 2
        row_name = r == 0 ? "BULL" : r == 1 ? "BEAR" : "SIDE"
        table.cell(tbl_m, 0, r + 2, row_name, text_color=color.new(color.white, 35), bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_center)
        for c = 0 to 2
            ir = disp_to_internal(r)
            ic = disp_to_internal(c)
            p  = array.get(P, ir * 3 + ic)
            is_diag = (r == c)
            cell_bg  = is_diag ? color.new(#3FDE7E, 80) : color.new(#0B0F0D, 8)
            cell_txt = is_diag ? #6BF0A6 : color.new(color.white, 55)
            table.cell(tbl_m, c + 1, r + 2, fmt_pct(p), text_color=cell_txt, bgcolor=cell_bg, text_size=size.tiny, text_halign=text.align_center)

    // Footer: stationary distribution
    table.cell(tbl_m, 0, 5, "π", text_color=color.new(color.white, 60), bgcolor=color.new(#0B0F0D, 8), text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl_m, 1, 5, fmt_pct(array.get(M, 0 * 3 + 1)), text_color=#6BF0A6, bgcolor=color.new(#3FDE7E, 85), text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl_m, 2, 5, fmt_pct(array.get(M, 0 * 3 + 2)), text_color=#6BF0A6, bgcolor=color.new(#3FDE7E, 85), text_size=size.tiny, text_halign=text.align_center)
    table.cell(tbl_m, 3, 5, fmt_pct(array.get(M, 0 * 3 + 0)), text_color=#6BF0A6, bgcolor=color.new(#3FDE7E, 85), text_size=size.tiny, text_halign=text.align_center)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(circuit_breaker and not circuit_breaker[1], "Circuit Breaker ON", "⚠️ CIRCUIT BREAKER — Macro backwardation / Z<-2 / COR1M panic — halt all put selling")
alertcondition(not circuit_breaker and circuit_breaker[1], "Circuit Breaker OFF", "✅ Circuit breaker cleared — reassess entries")
alertcondition(signal_0dte == 0 and signal_0dte[1] != 0, "0DTE GREEN", "🟢 0DTE Entry — VIX1D reversal, VRP+, contango")
alertcondition(signal_weekly == 0 and signal_weekly[1] != 0, "Weekly GREEN", "🟢 Weekly Entry — vol spike reversing, VRP+, contango")
alertcondition(signal_monthly == 0 and signal_monthly[1] != 0, "Monthly GREEN", "🟢 Monthly Entry — 5+ GREEN metrics, no REDs")
alertcondition(vvix_red and not vvix_red[1], "VVIX Warning", "⚠️ VVIX > 115 in calm market — anticipate vol expansion")
alertcondition(bbw_red and not bbw_red[1], "BBW Coiled Spring", "⚠️ BBW at multi-month low — breakout imminent, reduce size")
alertcondition(regime == 2 and regime[1] != 2, "Bear Regime", "🐻 Markov regime flipped BEAR — strikes widened, GREEN blocked")
alertcondition(regime == 1 and regime[1] != 1, "Bull Regime", "🟢 Markov regime flipped BULL — full signal set active")
