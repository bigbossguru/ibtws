// SPX Volatility Analysis System for Options Premium Selling
// Overlay indicator with Expected Move bands, strike levels, and compact dashboard
//@version=5
indicator("SPX Vol Analysis System", overlay=true, max_lines_count=500, max_labels_count=50)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
grp_data = "Data Sources"
vix_sym      = input.symbol("CBOE:VIX",   "VIX",        group=grp_data)
vix1d_sym    = input.symbol("CBOE:VIX1D", "VIX1D",      group=grp_data)
vix9d_sym    = input.symbol("CBOE:VIX9D", "VIX9D",      group=grp_data)
vix3m_sym    = input.symbol("CBOE:VIX3M", "VIX3M",      group=grp_data)
vvix_sym     = input.symbol("CBOE:VVIX",  "VVIX",       group=grp_data)

grp_params = "Parameters"
zscore_len   = input.int(20, "Z-Score Lookback", minval=5, group=grp_params)
rv_len       = input.int(20, "Realized Vol Lookback", minval=5, group=grp_params)
dte_weekly   = input.int(7,  "Weekly DTE", minval=1, group=grp_params)
dte_monthly  = input.int(30, "Monthly DTE", minval=14, group=grp_params)

grp_display = "Display"
show_em_bands  = input.bool(true, "Expected Move Bands", group=grp_display)
show_strikes   = input.bool(true, "Recommended Strikes", group=grp_display)
show_dashboard = input.bool(true, "Dashboard Panel", group=grp_display)
dash_pos       = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_display)

// ─── DATA ────────────────────────────────────────────────────────────────────
vix   = request.security(vix_sym,   timeframe.period, close)
vix1d = request.security(vix1d_sym, timeframe.period, close)
vix9d = request.security(vix9d_sym, timeframe.period, close)
vix3m = request.security(vix3m_sym, timeframe.period, close)
vvix  = request.security(vvix_sym,  timeframe.period, close)

spx = close

// ─── METRIC 1: VIX Z-SCORE ──────────────────────────────────────────────────
vix_sma   = ta.sma(vix, zscore_len)
vix_stdev = ta.stdev(vix, zscore_len)
vix_zscore = vix_stdev != 0 ? (vix - vix_sma) / vix_stdev : 0.0

// ─── METRIC 2: EXPECTED MOVE (anchored to session open) ──────────────────────
var float open_price = na
var float open_vix   = na
is_new_session = session.isfirstbar
if is_new_session
    open_price := open
    open_vix   := vix

em_open_1d  = nz(open_price) * (nz(open_vix) / 100.0) / math.sqrt(252)
em_open_w   = nz(open_price) * (nz(open_vix) / 100.0) / math.sqrt(252) * math.sqrt(dte_weekly)
em_open_m   = nz(open_price) * (nz(open_vix) / 100.0) / math.sqrt(252) * math.sqrt(dte_monthly)

// ─── METRIC 3: TERM STRUCTURE ────────────────────────────────────────────────
ratio_macro    = vix3m != 0 ? vix / vix3m : 1.0
ratio_weekly   = vix9d != 0 ? vix / vix9d : 1.0
ratio_intraday = vix   != 0 ? vix1d / vix : 1.0

// ─── METRIC 4: VRP ──────────────────────────────────────────────────────────
log_ret = math.log(close / close[1])
rv_20   = ta.stdev(log_ret, rv_len) * math.sqrt(252) * 100
vrp     = vix - rv_20

// ─── METRIC 5: VVIX ─────────────────────────────────────────────────────────
vvix_declining = vvix < vvix[1]

// ─── CIRCUIT BREAKER ─────────────────────────────────────────────────────────
circuit_breaker = ratio_macro > 1.15 or vix_zscore < -2.0

// ─── STRATEGY SIGNALS ────────────────────────────────────────────────────────
sig_0dte_green = ratio_intraday > 1.25 and ratio_intraday < ratio_intraday[1] and vvix_declining
sig_weekly_green = vix_zscore > 1.5 and ratio_weekly < 0.90 and vrp > 0
sig_monthly_green = vix_zscore > 1.0 and ratio_macro < 1.0 and vrp > 2.0

signal_0dte    = circuit_breaker ? 2 : sig_0dte_green ? 0 : 1
signal_weekly  = circuit_breaker ? 2 : sig_weekly_green ? 0 : 1
signal_monthly = circuit_breaker ? 2 : sig_monthly_green ? 0 : 1

// ─── EXPECTED MOVE BANDS ─────────────────────────────────────────────────────
em_up_0 = nz(open_price) + em_open_1d
em_dn_0 = nz(open_price) - em_open_1d
em_up_w = nz(open_price) + em_open_w
em_dn_w = nz(open_price) - em_open_w
em_up_m = nz(open_price) + em_open_m
em_dn_m = nz(open_price) - em_open_m
em_mid  = nz(open_price)

p_eu_m = plot(show_em_bands ? em_up_m : na, "EM+ Monthly", color=color.new(color.purple, 80), linewidth=1)
p_ed_m = plot(show_em_bands ? em_dn_m : na, "EM- Monthly", color=color.new(color.purple, 80), linewidth=1)
p_eu_w = plot(show_em_bands ? em_up_w : na, "EM+ Weekly",  color=color.new(color.blue, 60), linewidth=2)
p_ed_w = plot(show_em_bands ? em_dn_w : na, "EM- Weekly",  color=color.new(color.blue, 60), linewidth=2)
p_eu_0 = plot(show_em_bands ? em_up_0 : na, "EM+ 0DTE",   color=color.new(color.orange, 50), linewidth=2, style=plot.style_stepline)
p_ed_0 = plot(show_em_bands ? em_dn_0 : na, "EM- 0DTE",   color=color.new(color.orange, 50), linewidth=2, style=plot.style_stepline)
p_mid  = plot(show_em_bands ? em_mid  : na, "Open Price",  color=color.new(color.white, 70), linewidth=1, style=plot.style_stepline)

fill(p_eu_0, p_mid, color=color.new(color.orange, 94), title="EM 0DTE Upper Fill")
fill(p_ed_0, p_mid, color=color.new(color.orange, 94), title="EM 0DTE Lower Fill")
fill(p_eu_w, p_eu_0, color=color.new(color.blue, 95), title="EM Weekly Upper Fill")
fill(p_ed_w, p_ed_0, color=color.new(color.blue, 95), title="EM Weekly Lower Fill")
fill(p_eu_m, p_eu_w, color=color.new(color.purple, 95), title="EM Monthly Upper Fill")
fill(p_ed_m, p_ed_w, color=color.new(color.purple, 95), title="EM Monthly Lower Fill")

// ─── STRIKE LEVELS ───────────────────────────────────────────────────────────
strike_0dte    = nz(open_price) - 1.5 * em_open_1d
strike_weekly  = nz(open_price) - 2.0 * em_open_w
strike_monthly = nz(open_price) - 2.5 * em_open_m

plot(show_strikes and signal_0dte == 0 ? strike_0dte : na, "Strike 0DTE", color=color.lime, style=plot.style_linebr, linewidth=2)
plot(show_strikes and signal_weekly == 0 ? strike_weekly : na, "Strike Weekly", color=color.green, style=plot.style_linebr, linewidth=2)
plot(show_strikes and signal_monthly == 0 ? strike_monthly : na, "Strike Monthly", color=color.teal, style=plot.style_linebr, linewidth=1)

// ─── ON-CHART MARKERS ────────────────────────────────────────────────────────
plotshape(signal_0dte == 0 and signal_0dte[1] != 0, "0DTE Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="0DTE")
plotshape(signal_weekly == 0 and signal_weekly[1] != 0, "Weekly Entry", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="WK")
plotshape(circuit_breaker and not circuit_breaker[1], "CB ON", style=shape.xcross, location=location.abovebar, color=color.red, size=size.normal, text="HALT")

// ─── BACKGROUND & BAR COLOR ──────────────────────────────────────────────────
bgcolor(circuit_breaker ? color.new(color.red, 93) : na, title="Circuit Breaker BG")
barcolor(circuit_breaker ? color.new(color.red, 40) : vix_zscore > 2.0 ? color.new(color.orange, 40) : na, title="Regime Bar Color")

// ─── COMPACT DASHBOARD ───────────────────────────────────────────────────────
if show_dashboard and barstate.islast
    tbl_pos = switch dash_pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

    var tbl = table.new(tbl_pos, 2, 10, border_width=1, border_color=color.new(color.gray, 70), bgcolor=color.new(#1a1a2e, 0))

    // VIX + Z-Score
    z_col = vix_zscore > 2 ? color.red : vix_zscore > 1 ? color.orange : vix_zscore < -2 ? color.yellow : color.white
    table.cell(tbl, 0, 0, "VIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 0, str.tostring(vix, "#.#") + "  Z:" + str.tostring(vix_zscore, "+#.#"), text_color=z_col, text_size=size.tiny, text_halign=text.align_right)

    // VRP
    table.cell(tbl, 0, 1, "VRP", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 1, str.tostring(vrp, "+#.#") + (vrp > 0 ? " ✓" : " ✗"), text_color=vrp > 0 ? color.green : color.red, text_size=size.tiny, text_halign=text.align_right)

    // Term Structure (macro)
    table.cell(tbl, 0, 2, "VIX/3M", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(ratio_macro, "#.##") + (ratio_macro > 1.0 ? " BW" : " CT"), text_color=ratio_macro > 1.0 ? color.red : color.green, text_size=size.tiny, text_halign=text.align_right)

    // Term Structure (weekly)
    table.cell(tbl, 0, 3, "VIX/9D", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 3, str.tostring(ratio_weekly, "#.##") + (ratio_weekly < 1.0 ? " LBW" : " CT"), text_color=ratio_weekly < 1.0 ? color.orange : color.green, text_size=size.tiny, text_halign=text.align_right)

    // VIX1D/VIX
    intra_col = ratio_intraday > 1.25 ? color.red : ratio_intraday > 1.0 ? color.orange : ratio_intraday > 0.85 ? color.white : color.green
    table.cell(tbl, 0, 4, "1D/VIX", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 4, str.tostring(ratio_intraday, "#.##") + (ratio_intraday > 1.25 ? " 🔥" : ratio_intraday > 1.0 ? " !" : ""), text_color=intra_col, text_size=size.tiny, text_halign=text.align_right)

    // EM
    table.cell(tbl, 0, 5, "EM", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 5, "±" + str.tostring(em_open_1d, "#") + "d  ±" + str.tostring(em_open_w, "#") + "w", text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    // Signals
    col_0 = signal_0dte == 0 ? color.lime : signal_0dte == 1 ? color.yellow : color.red
    col_w = signal_weekly == 0 ? color.lime : signal_weekly == 1 ? color.yellow : color.red
    col_m = signal_monthly == 0 ? color.lime : signal_monthly == 1 ? color.yellow : color.red

    table.cell(tbl, 0, 6, "", text_size=size.tiny, bgcolor=color.new(#0f3460, 0))
    table.cell(tbl, 1, 6, "", text_size=size.tiny, bgcolor=color.new(#0f3460, 0))

    table.cell(tbl, 0, 7, "0DTE", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 7, signal_0dte == 0 ? "GO <" + str.tostring(strike_0dte, "#") : signal_0dte == 1 ? "WAIT" : "STOP", text_color=col_0, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 8, "WEEKLY", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 8, signal_weekly == 0 ? "GO <" + str.tostring(strike_weekly, "#") : signal_weekly == 1 ? "WAIT" : "STOP", text_color=col_w, text_size=size.tiny, text_halign=text.align_right)

    table.cell(tbl, 0, 9, "MONTHLY", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, 9, signal_monthly == 0 ? "GO <" + str.tostring(strike_monthly, "#") : signal_monthly == 1 ? "WAIT" : "STOP", text_color=col_m, text_size=size.tiny, text_halign=text.align_right)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(circuit_breaker and not circuit_breaker[1], "Circuit Breaker ON", "⚠️ SPX Vol: CIRCUIT BREAKER — halt put selling")
alertcondition(sig_0dte_green and not sig_0dte_green[1], "0DTE GREEN", "🟢 0DTE Entry — VIX1D reversal + VVIX declining")
alertcondition(sig_weekly_green and not sig_weekly_green[1], "Weekly GREEN", "🟢 Weekly Entry — Z>1.5, fear spike, VRP+")
alertcondition(sig_monthly_green and not sig_monthly_green[1], "Monthly GREEN", "🟢 Monthly Entry — elevated vol, contango, VRP>2")
